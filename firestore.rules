rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened global helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isFiniteCoord(v) {
      return (v is int || v is float) && v >= -500 && v <= 500;
    }

    // Validation Blueprint (used on both create and update)
    function isValidMonolithNote(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'body',
          'partName',
          'color',
          'posX',
          'posY',
          'posZ',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'body',
          'partName',
          'color',
          'posX',
          'posY',
          'posZ',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 1000
        && data.partName is string
        && data.partName.size() >= 1
        && data.partName.size() <= 64
        && data.color is string
        && data.color.size() <= 16
        && data.color in ['amber', 'emerald', 'crimson', 'ivory']
        && isFiniteCoord(data.posX)
        && isFiniteCoord(data.posY)
        && isFiniteCoord(data.posZ)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User-owned 3D notes pinned to specific parts of the desert monolith
    match /monolith_notes/{noteId} {
      allow get: if isSignedIn()
        && isValidId(noteId)
        && existing().ownerId == request.auth.uid;

      // Pillar 8: Rule enforces ownership directly on resource.data (zero get() lookups)
      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(noteId)
        && isValidMonolithNote(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(noteId)
        && isValidMonolithNote(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit note text, label, color, or coordinates
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'body',
            'partName',
            'color',
            'posX',
            'posY',
            'posZ',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(noteId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
